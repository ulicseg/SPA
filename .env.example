# Django Settings
SECRET_KEY=CAMBIA-ESTA-CLAVE-POR-UNA-UNICA-Y-SEGURA-GENERADA-CON-get_random_secret_key
DEBUG=True

# ⚠️ IMPORTANTE: En producción cambiar DEBUG=False y configurar ALLOWED_HOSTS
# DEBUG=False
# ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# Database Settings (SQLite por defecto, PostgreSQL opcional)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Para PostgreSQL, descomenta y configura las siguientes líneas:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=gestorspa
# DB_USER=postgres
# DB_PASSWORD=tu_contraseña_postgres
# DB_HOST=localhost
# DB_PORT=5432

# Internationalization
LANGUAGE_CODE=es-ar
TIME_ZONE=America/Argentina/Buenos_Aires
USE_I18N=True
USE_TZ=True

# Static files
STATIC_URL=static/
MEDIA_URL=/media/

# Authentication
LOGIN_REDIRECT_URL=usuarios:perfil
LOGIN_URL=login
LOGOUT_REDIRECT_URL=home

# Email Settings (opcional - para notificaciones)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_email@gmail.com
# EMAIL_HOST_PASSWORD=tu_contraseña_app

# Sistema de Roles - GestorSpa
# Los roles se configuran automáticamente al ejecutar:
# python manage.py setup_roles --create-groups

# 🔒 SEGURIDAD: No hay usuarios predeterminados
# Debes crear tu propio superusuario con: python manage.py createsuperuser
# Luego asignar roles desde el panel de administración o comandos de gestión
